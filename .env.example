# Sao file này thành .env.local rồi điền giá trị thật.
# .env.local đã được gitignore — không bao giờ commit nó.
#
# Hai giá trị dưới đây lấy ở Supabase Dashboard:
#   Project Settings -> API
#
# Lưu ý: anon key được THIẾT KẾ để nằm công khai trong code frontend.
# An toàn dữ liệu đến từ Row Level Security trong Postgres, không từ việc giấu key.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Tuỳ chọn — theo dõi lỗi khi partner báo "app lỗi rồi"
# VITE_SENTRY_DSN=
